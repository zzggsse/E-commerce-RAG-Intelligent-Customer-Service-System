# ==== 复制本文件为 .env 并填写，即可覆盖 settings.py 里的默认值 ====
LLM_API_KEY=sk-你的key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 向量库：milvus(Docker 部署, 默认) / local(内存向量库, 无 Milvus 时预览或出图)
VECTOR_BACKEND=milvus
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530

# 模型尽量用本地目录（首启才会去 HF 下载）
EMBEDDING_MODEL=models/bge-large-zh-v1.5
EMBEDDING_DEVICE=cpu
# rerank: none(默认，跳过)/local(需下载 bge-reranker-base)/dashscope(阿里云 API)
RERANK_BACKEND=none

# =============================================================
# 语音输入（ASR 语音识别）：前端话筒接入后端 API
#   兼容 OpenAI 的 /audio/transcriptions 转写接口（Whisper 系列），
#   ASR_ENABLED=true 且填好 ASR_API_KEY 后，前端录音会走后端 /asr 接口；
#   否则自动回退到浏览器内置语音识别（无需 API）。
# =============================================================
ASR_ENABLED=false
ASR_BASE_URL=https://api.openai.com/v1
ASR_API_KEY=
ASR_MODEL=whisper-1
ASR_LANGUAGE=zh
